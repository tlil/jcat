#!/usr/bin/env bash
set -euo pipefail

readonly go_version="1.22.12"
readonly repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

case "$(uname -m)" in
	x86_64)
		go_arch="amd64"
		go_sha256="4fa4f869b0f7fc6bb1eb2660e74657fbf04cdd290b5aef905585c86051b34d43"
		;;
	aarch64 | arm64)
		go_arch="arm64"
		go_sha256="fd017e647ec28525e86ae8203236e0653242722a7436929b1f775744e26278e7"
		;;
	*)
		echo "Unsupported architecture: $(uname -m)" >&2
		exit 1
		;;
esac

readonly go_root="$HOME/.local/share/go/$go_version"
readonly local_bin="$HOME/.local/bin"

step_started=$SECONDS
echo "Preparing Go $go_version..."
if [[ ! -x "$go_root/bin/go" ]] || ! "$go_root/bin/go" version | grep -Fq "go$go_version"; then
	archive="$(mktemp)"
	extract_dir="$(mktemp -d)"
	trap 'rm -f "$archive"; rm -rf "$extract_dir"' EXIT

	curl --fail --silent --show-error --location --retry 3 \
		"https://go.dev/dl/go${go_version}.linux-${go_arch}.tar.gz" \
		--output "$archive"
	echo "$go_sha256  $archive" | sha256sum --check --status
	tar -C "$extract_dir" -xzf "$archive"
	mkdir -p "$(dirname "$go_root")"
	rm -rf "$go_root"
	mv "$extract_dir/go" "$go_root"
fi
mkdir -p "$local_bin"
ln -sfn "$go_root/bin/go" "$local_bin/go"
ln -sfn "$go_root/bin/gofmt" "$local_bin/gofmt"
echo "Go ready in $((SECONDS - step_started))s: $("$local_bin/go" version)"

step_started=$SECONDS
echo "Downloading Go module dependencies..."
cd "$repo_root"
"$local_bin/go" mod download
echo "Dependencies ready in $((SECONDS - step_started))s."
